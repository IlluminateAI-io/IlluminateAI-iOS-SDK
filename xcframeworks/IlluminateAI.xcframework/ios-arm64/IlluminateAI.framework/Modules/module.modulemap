framework module IlluminateAI {
    umbrella header "IlluminateAI.h"

    export *
	module * { export * }
	explicit module Private {
		header "IlluminateAIPrivate.h"
		header "FaceCapturePrivate.h"
		header "NSDataPlus.h"
		header "IteratePoly.h"
	}
}

module IlluminateAI.Swift {
  header "IlluminateAI-Swift.h"
  requires objc
}
